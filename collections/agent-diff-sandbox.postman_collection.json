  "info": {
    "_postman_id": "f754438b-5a92-46ef-9412-00a1b40900b2",
    "name": "Agent Diff Sandbox API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Agent Diff Sandbox API creates isolated, ephemeral replicas of third-party APIs such as Slack and Linear. Agents interact with these sandboxes to produce deterministic state-change diffs without side effects, rate limits, or real API calls.\n\nContact Support:\n Name: Agent Diff",
